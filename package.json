{
  "name": "@wangmuy/dsh-provider-dispatcher",
  "description": "A generic provider-dispatcher proxy for DeepSeek Harness. Mounts child plugins under a private isolate realm, records every register* call, and fans one operation out to all recorded children with a configurable strategy (parallel merge / race / bail).",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wangmuy/dsh-provider-dispatcher.git"
  },
  "author": "wangmuy",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./web-search-merge": "./src/web-search-merge.js",
    "./web-search-setup": "./src/web-search-setup.js",
    "./web-fetch-setup": "./src/web-fetch-setup.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "src",
    "LICENSE",
    "README.md",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public"
  }
}
